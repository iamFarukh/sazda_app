# Release (upload) keystore for Play Store builds.
#
# 1. Generate an upload keystore (keep this file + passwords SAFE and BACKED UP —
#    losing it means you can never update the app under the same listing):
#
#    keytool -genkeypair -v -keystore sazda-upload.keystore \
#      -alias sazda-upload -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Copy this file to android/keystore.properties (which is gitignored) and fill in
#    the real values below. Put the .keystore/.jks file somewhere outside version
#    control (e.g. android/) — storeFile is resolved relative to the android/ folder.
#
# 3. Register the upload + app-signing SHA-1/SHA-256 fingerprints in the Firebase
#    Console so Google Sign-In works on Play-distributed builds, then download the
#    updated google-services.json.

storeFile=sazda-upload.keystore
storePassword=CHANGE_ME
keyAlias=sazda-upload
keyPassword=CHANGE_ME
